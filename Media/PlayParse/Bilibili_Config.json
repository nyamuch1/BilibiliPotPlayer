{
	// 填写账号 Cookie
	"cookie": "",
	"maxliveroom": 200,
	"danmaku": {
		// 控制是否接收弹幕。按 Alt+H 可显示/隐藏弹幕
		// 不需要弹幕服务器：留空即可，插件会直接取 B 站的弹幕 XML 自己转成 ASS，
		// 字幕也直接用 B 站自己的 JSON 地址。
		// 只有想走自建服务器时才填 server
		"enable": true,
		"server": "",
		// 字体
		"font": "微软雅黑",
		// 字号
		"fontSize": 30.0,
		// 弹幕不透明度，取值范围 0.0 ~ 1.0
		"opacity": 0.8,
		// 弹幕显示区域大小，取值范围 0.0 ~ 1.0
		"displayArea": 0.8,
		// 弹幕显示时间
		"stayTime": 15.0
	},
	// 播放单个视频时是否显示推荐的视频
	"showRecommendedVideos": true,
	"debug": false
}
