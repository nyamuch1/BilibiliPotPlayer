{
	// 填写账号 Cookie
	"cookie": "",
	"maxliveroom": 200,
	"danmaku": {
		// 字幕/弹幕总开关。按 Alt+H 可显示/隐藏
		// 字幕：不需要服务器，直接用 B 站自己的字幕地址
		// 弹幕：需要服务器，把地址填到下面的 server；留空则只显示字幕
		"enable": true,
		"server": "",
		// 字体
		"font": "微软雅黑",
		// 字号
		"fontSize": 30.0,
		// 弹幕不透明度，取值范围 0.0 ~ 1.0
		"opacity": 0.8,
		// 弹幕显示区域大小，取值范围 0.0 ~ 1.0
		"displayArea": 0.8,
		// 弹幕显示时间
		"stayTime": 15.0
	},
	// 播放单个视频时是否显示推荐的视频
	"showRecommendedVideos": true,
	"debug": false
}
